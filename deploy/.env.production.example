# Configuración de Entorno de Producción (VPS Ubuntu 24.04 LTS)
# IMPORTANTE: Copiar este archivo a /var/www/mvp-project/.env en el servidor y asignar permisos 600.
# NUNCA versionar el archivo .env real en Git.

# Clave secreta criptográfica de Django (generar una única y segura para producción)
# Ejemplo para generar: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY="cambiar-por-una-clave-secreta-larga-y-aleatoria-en-produccion"

# Modo depuración (SIEMPRE False en producción)
DEBUG=False

# Dominios y hosts autorizados (separados por comas o espacios)
# Incluir tanto el FQDN con y sin www, y opcionalmente la IP pública
ALLOWED_HOSTS="tu-dominio.com,www.tu-dominio.com,127.0.0.1,localhost"

# Orígenes confiables para protección CSRF sobre HTTPS
CSRF_TRUSTED_ORIGINS="https://tu-dominio.com,https://www.tu-dominio.com"

# Base de datos (por defecto SQLite local en esta fase, o PostgreSQL para fases posteriores)
DATABASE_URL="sqlite:////var/www/mvp-project/db.sqlite3"
# DATABASE_URL="postgres://usuario:password@localhost:5432/mvp_db"
